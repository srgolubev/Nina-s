---
import site from '../../content/global/site.json';

const ICONS: Record<string, string> = {
  facebook:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3H13.5V8.6c0-.87.27-1.46 1.51-1.46h1.61V4.46C16.3 4.42 15.34 4.34 14.22 4.34c-2.33 0-3.93 1.42-3.93 4.03V10.5H7.8v3h2.49V21h3.21z"/></svg>',
  instagram:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="3.7"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.5 4.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3 9.5h3v11H3v-11zM9 9.5h2.86v1.5h.04c.4-.74 1.37-1.52 2.82-1.52 3.02 0 3.58 1.98 3.58 4.56v6.46h-3v-5.73c0-1.37-.02-3.13-1.91-3.13-1.91 0-2.2 1.49-2.2 3.03v5.83H9v-11z"/></svg>',
  twitter:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.5 6.4a8 8 0 0 1-2.3.64 4.02 4.02 0 0 0 1.76-2.22 8 8 0 0 1-2.54.97 4 4 0 0 0-6.81 3.65A11.34 11.34 0 0 1 3.4 5.16a4 4 0 0 0 1.24 5.34 4 4 0 0 1-1.81-.5v.05a4 4 0 0 0 3.21 3.92 4 4 0 0 1-1.8.07 4 4 0 0 0 3.74 2.78A8.04 8.04 0 0 1 2.5 18.5 11.33 11.33 0 0 0 8.64 20.3c7.36 0 11.39-6.1 11.39-11.4l-.01-.52A8.1 8.1 0 0 0 21.5 6.4z"/></svg>',
};

const LABELS: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  linkedin: 'LinkedIn',
  twitter: 'Twitter',
};

const socials = site.socials.filter((s) => ICONS[s.platform]);
---

<footer class="site-footer">
  <div class="footer-inner">
    <nav class="socials" aria-label="Social media">
      {
        socials.map((s) => (
          <a href={s.url} aria-label={LABELS[s.platform]} set:html={ICONS[s.platform]} />
        ))
      }
    </nav>
    <p class="disclaimer">{site.disclaimer}</p>
    <p class="copyright">{site.copyright}</p>
  </div>
</footer>
