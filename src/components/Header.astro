---
import site from '../../content/global/site.json';
import { withBase } from '../lib/url';

interface Props {
  // Set on pages where the header sits over a light background (the homepage
  // hero), so its text switches from white to a dark, readable colour.
  light?: boolean;
}

const { light = false } = Astro.props;

const strip = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const current = strip(Astro.url.pathname);
const isActive = (href: string) => strip(withBase(href)) === current;

type NavLeaf = { label: string; href: string };
type NavGroup = { label: string; children: NavLeaf[] };
type NavItem = NavLeaf | NavGroup;
const isGroup = (item: NavItem): item is NavGroup =>
  Array.isArray((item as NavGroup).children) && (item as NavGroup).children.length > 0;
const groupActive = (group: NavGroup) => group.children.some((c) => isActive(c.href));
---

<header class:list={['site-header', light && 'is-on-light']}>
  <a class="logo" href={withBase('/')} aria-label={`${site.logoName} ${site.logoCaption} home`}>
    <svg
      class="logo-burst"
      viewBox="0 0 80 22"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M40 21 L40 3"></path>
      <path d="M40 21 L29 5"></path>
      <path d="M40 21 L51 5"></path>
      <path d="M40 21 L20 9"></path>
      <path d="M40 21 L60 9"></path>
      <path d="M40 21 L14 14"></path>
      <path d="M40 21 L66 14"></path>
    </svg>
    <span class="logo-name">{site.logoName}</span>
    <span class="logo-caption">
      <span class="logo-hairline" aria-hidden="true"></span>
      <span class="logo-caption-text">{site.logoCaption}</span>
      <span class="logo-hairline" aria-hidden="true"></span>
    </span>
  </a>

  <nav aria-label="Primary">
    <ul class="nav-list">
      {
        (site.nav as NavItem[]).map((item, i) =>
          isGroup(item) ? (
            <li class:list={['has-children', groupActive(item) && 'is-active']}>
              <button
                type="button"
                class="nav-toggle"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls={`submenu-${i}`}
              >
                <span>{item.label}</span>
                <span class="chev" aria-hidden="true">▾</span>
              </button>
              <ul class="submenu" id={`submenu-${i}`} role="menu">
                {item.children.map((child) => (
                  <li role="none">
                    <a
                      role="menuitem"
                      href={withBase(child.href)}
                      aria-current={isActive(child.href) ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          )
        )
      }
    </ul>
    <button
      class="burger"
      id="burger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>
  </nav>
</header>

<!-- Mobile nav panel -->
<div class="mobile-nav" id="mobile-nav" aria-hidden="true">
  <button class="mobile-nav-close" id="mobile-nav-close" aria-label="Close menu">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <line x1="6" y1="6" x2="18" y2="18"></line>
      <line x1="18" y1="6" x2="6" y2="18"></line>
    </svg>
  </button>
  {
    (site.nav as NavItem[]).map((item, i) =>
      isGroup(item) ? (
        <div class:list={['mobile-nav-group', groupActive(item) && 'is-active']}>
          <button
            type="button"
            class="mobile-nav-toggle"
            aria-expanded="false"
            aria-controls={`m-submenu-${i}`}
          >
            <span>{item.label}</span>
            <span class="chev" aria-hidden="true">▾</span>
          </button>
          <div class="mobile-submenu" id={`m-submenu-${i}`}>
            {item.children.map((child) => (
              <a
                href={withBase(child.href)}
                data-close
                aria-current={isActive(child.href) ? 'page' : undefined}
              >
                {child.label}
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a href={withBase(item.href)} data-close aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      )
    )
  }
</div>

<script>
  const burger = document.getElementById('burger');
  const panel = document.getElementById('mobile-nav');
  const closeBtn = document.getElementById('mobile-nav-close');

  if (burger && panel && closeBtn) {
    const open = () => {
      panel.classList.add('is-open');
      panel.setAttribute('aria-hidden', 'false');
      burger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      panel.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      burger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };
    burger.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    panel.querySelectorAll('[data-close]').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  // Desktop dropdown (Inner Compass): tap/keyboard toggle. Hover-open is
  // handled via CSS, so this layer only adds support for touch and a11y.
  const closeAllDropdowns = (except?: Element) => {
    document.querySelectorAll('.has-children.is-open').forEach((li) => {
      if (li === except) return;
      li.classList.remove('is-open');
      li.querySelector('.nav-toggle')?.setAttribute('aria-expanded', 'false');
    });
  };
  document.querySelectorAll<HTMLButtonElement>('.has-children > .nav-toggle').forEach((btn) => {
    const parent = btn.parentElement as HTMLElement;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasOpen = parent.classList.contains('is-open');
      closeAllDropdowns(parent);
      parent.classList.toggle('is-open', !wasOpen);
      btn.setAttribute('aria-expanded', !wasOpen ? 'true' : 'false');
    });
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (!document.querySelector('.has-children.is-open')) return;
    document.querySelectorAll('.has-children.is-open').forEach((li) => {
      if (!li.contains(t)) {
        li.classList.remove('is-open');
        li.querySelector('.nav-toggle')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllDropdowns();
  });

  // Mobile nav: expand/collapse the Inner Compass group inside the slide-in
  // panel. Tapping a child link still triggers [data-close], which closes
  // the whole panel.
  document.querySelectorAll<HTMLButtonElement>('.mobile-nav-group > .mobile-nav-toggle').forEach((btn) => {
    const group = btn.parentElement as HTMLElement;
    btn.addEventListener('click', () => {
      const open = group.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });
</script>
