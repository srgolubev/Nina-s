---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { withBase } from '../lib/url';
import page from '../../content/pages/coaching.json';

const {
  seo,
  title,
  tagline,
  intro,
  supportiveTitle,
  supportive,
  formatTitle,
  format,
  packagesTitle,
  packagesIntro,
  packages,
  noticeTitle,
  notice,
} = page;

const isExternal = (url: string) => /^https?:\/\//i.test(url);

// Schema.org Service with an offer per package. This is what AI engines
// reach for when answering "thoughtful coaching for women, what does it
// cost?" Each package becomes a named Offer with USD price.
const site = Astro.site ?? new URL('https://srgolubev.github.io');
const priceNumber = (p: string) => Number(String(p).replace(/[^0-9.]/g, '')) || 0;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL(withBase('/coaching'), site).href + '#service',
  name: 'Tranquil Haven Coaching',
  url: new URL(withBase('/coaching'), site).href,
  description: intro,
  serviceType: 'Coaching',
  areaServed: 'Worldwide (online)',
  availableLanguage: ['English', 'Russian'],
  provider: {
    '@type': 'Organization',
    name: 'Tranquil Haven Coaching',
    url: new URL(withBase('/'), site).href,
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: packagesTitle,
    itemListElement: (packages || []).map((p: any) => ({
      '@type': 'Offer',
      name: p.name,
      description: p.tagline,
      price: priceNumber(p.price),
      priceCurrency: 'USD',
      category: p.sessionsLabel,
      url: p.ctaHref,
    })),
  },
};
---

<Base title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <Header />
  <PageHero title={title} tagline={tagline} />

  <main class="page-main">
    <div class="container narrow">
      <p class="lead reveal">{intro}</p>

      <section class="panel reveal" aria-labelledby="supportive-h">
        <h2 id="supportive-h" class="panel-title">{supportiveTitle}</h2>
        <ul class="feature-list">
          {supportive.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="panel reveal" aria-labelledby="format-h">
        <h2 id="format-h" class="panel-title">{formatTitle}</h2>
        <ul class="feature-list">
          {format.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      {
        packages && packages.length > 0 && (
          <section class="packages reveal" aria-labelledby="packages-h">
            <h2 id="packages-h" class="panel-title">{packagesTitle}</h2>
            {packagesIntro && <p class="packages-intro">{packagesIntro}</p>}
            <div class="packages-grid">
              {packages.map((pack) => {
                const external = isExternal(pack.ctaHref);
                return (
                  <article class="package-card">
                    <header class="package-head">
                      <h3 class="package-name">{pack.name}</h3>
                      {pack.sessionsLabel && (
                        <span class="package-sessions">{pack.sessionsLabel}</span>
                      )}
                      <span class="package-price">{pack.price}</span>
                    </header>
                    {pack.tagline && <p class="package-tagline">{pack.tagline}</p>}
                    {pack.description && (
                      <p class="package-description">{pack.description}</p>
                    )}
                    <a
                      class="btn btn-primary package-cta"
                      href={withBase(pack.ctaHref)}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                    >
                      <span>{pack.ctaLabel || 'Book this'}</span>
                      <span class="btn-caret" aria-hidden="true">›</span>
                    </a>
                  </article>
                );
              })}
            </div>
          </section>
        )
      }

      <section class="note note--block reveal" aria-labelledby="notice-h">
        <h2 id="notice-h" class="note-title">{noticeTitle}</h2>
        <p>{notice}</p>
      </section>
    </div>
  </main>

  <Footer />
</Base>
