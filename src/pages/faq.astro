---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import RichText from '../components/RichText.astro';
import page from '../../content/pages/faq.json';

const { seo, title, tagline, intro, items } = page;

// Strip markdown to a plain-text Answer body for JSON-LD. FAQ answers
// here are short, so the simple "drop syntax" approach is enough.
const stripMd = (s: string): string =>
  String(s ?? '')
    .replace(/\r\n?/g, '\n')
    .replace(/`{1,3}/g, '')
    .replace(/\*\*|__|\*|_/g, '')
    .replace(/^#+\s*/gm, '')
    .replace(/\n{2,}/g, '\n\n')
    .trim();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: (items || []).map((it: any) => ({
    '@type': 'Question',
    name: it.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripMd(it.answer),
    },
  })),
};
---

<Base title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <Header />
  <PageHero title={title} tagline={tagline} />

  <main class="page-main">
    <div class="container narrow">
      {intro && <p class="lead lead--center reveal">{intro}</p>}

      <div class="faq-list">
        {
          items.map((item) => (
            <details class="faq-item reveal">
              <summary>
                <span class="faq-q">{item.question}</span>
                <span class="faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="faq-answer prose">
                <RichText content={item.answer} />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />
</Base>
