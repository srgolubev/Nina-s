---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Blocks from '../../components/Blocks.astro';
import { withBase } from '../../lib/url';
import page from '../../../content/pages/insights.json';

export function getStaticPaths() {
  const { articles } = page;
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { seo } = page;
---

<Base
  title={`${article.title} — TranquilHaven Coaching`}
  description={article.excerpt || seo.description}
>
  <Header />
  <PageHero title={article.title} tagline="Insights" />

  <main class="page-main">
    <div class="container narrow">
      <article class="prose article reveal">
        <Blocks blocks={article.body} />
      </article>

      <p class="back-link reveal">
        <a href={withBase('/insights')}>
          <span class="btn-caret btn-caret--back" aria-hidden="true">‹</span>
          <span>All insights</span>
        </a>
      </p>
    </div>
  </main>

  <Footer />
</Base>
