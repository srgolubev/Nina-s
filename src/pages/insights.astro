---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Reader from '../components/Reader.astro';
import page from '../../content/pages/insights.json';

const { seo, title, tagline, intro, articles } = page;
---

<Base title={seo.title} description={seo.description}>
  <Header />
  <PageHero title={title} tagline={tagline} />

  <main class="page-main">
    <div class="container">
      {intro && <p class="lead lead--center reveal">{intro}</p>}

      <div class="insight-grid">
        {
          articles.map((article) => (
            <article class="insight-card reveal">
              <h2>
                <a class="reader-link" href={`#${article.slug}`} data-slug={article.slug}>
                  {article.title}
                </a>
              </h2>
              <p class="insight-excerpt">{article.excerpt}</p>
              <a class="text-link reader-link" href={`#${article.slug}`} data-slug={article.slug}>
                <span>Read reflection</span>
                <span class="btn-caret" aria-hidden="true">›</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />

  <Reader sectionLabel="Insights" articles={articles} />
</Base>
