---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Reader from '../components/Reader.astro';
import { withBase } from '../lib/url';
import page from '../../content/pages/insights.json';
import { getPosts } from '../lib/posts';

const { seo, title, tagline, intro } = page;
const articles = getPosts('insights');
---

<Base title={seo.title} description={seo.description}>
  <Header />
  <PageHero title={title} tagline={tagline} />

  <main class="page-main">
    <div class="container">
      {intro && <p class="lead lead--center reveal">{intro}</p>}

      <div class="insight-grid">
        {
          articles.map((article) => (
            <article class="insight-card reveal">
              <h2>
                <a
                  class="reader-link"
                  href={withBase(`/insights/${article.slug}`)}
                  data-slug={article.slug}
                >
                  {article.title}
                </a>
              </h2>
              <p class="insight-excerpt">{article.excerpt}</p>
              <a
                class="text-link reader-link"
                href={withBase(`/insights/${article.slug}`)}
                data-slug={article.slug}
                aria-label={`Read insight: ${article.title}`}
              >
                <span>Read insight</span>
                <span class="btn-caret" aria-hidden="true">›</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />

  <Reader sectionLabel="Insights" articles={articles} closeLabel="Close insight" />
</Base>
