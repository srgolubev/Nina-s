---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import page from '../../content/pages/credentials.json';

const { seo, title, tagline, intro, items, note } = page;
---

<Base title={seo.title} description={seo.description}>
  <Header />
  <PageHero title={title} tagline={tagline} />

  <main class="page-main">
    <div class="container narrow">
      {intro && <p class="lead reveal">{intro}</p>}

      <section class="panel reveal">
        <ul class="feature-list feature-list--lg">
          {items.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      {note && <p class="note reveal">{note}</p>}
    </div>
  </main>

  <Footer />
</Base>
