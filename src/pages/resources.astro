---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Reader from '../components/Reader.astro';
import page from '../../content/pages/resources.json';

const { seo, title, tagline, intro, items } = page;
---

<Base title={seo.title} description={seo.description}>
  <Header />
  <PageHero title={title} tagline={tagline} />

  <main class="page-main">
    <div class="container">
      {intro && <p class="lead lead--center reveal">{intro}</p>}

      <div class="insight-grid">
        {
          items.map((item) => (
            <article class="insight-card reveal">
              <h2>
                <a class="reader-link" href={`#${item.slug}`} data-slug={item.slug}>
                  {item.title}
                </a>
              </h2>
              {item.excerpt && <p class="insight-excerpt">{item.excerpt}</p>}
              <a class="text-link reader-link" href={`#${item.slug}`} data-slug={item.slug}>
                <span>Open practice</span>
                <span class="btn-caret" aria-hidden="true">›</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />

  <Reader sectionLabel="Resources" articles={items} />
</Base>
