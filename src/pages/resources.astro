---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { withBase } from '../lib/url';
import page from '../../content/pages/resources.json';

const { seo, title, tagline, intro, items } = page;
---

<Base title={seo.title} description={seo.description}>
  <Header />
  <PageHero title={title} tagline={tagline} />

  <main class="page-main">
    <div class="container">
      {intro && <p class="lead lead--center reveal">{intro}</p>}

      <div class="insight-grid">
        {
          items.map((item) => (
            <article class="insight-card reveal">
              <h2>
                <a href={withBase(`/resources/${item.slug}`)}>{item.title}</a>
              </h2>
              {item.excerpt && <p class="insight-excerpt">{item.excerpt}</p>}
              <a class="text-link" href={withBase(`/resources/${item.slug}`)}>
                <span>Open practice</span>
                <span class="btn-caret" aria-hidden="true">›</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />
</Base>
