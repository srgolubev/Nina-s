---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';
import home from '../../content/pages/home.json';
import siteData from '../../content/global/site.json';

const { seo, hero, cards, cta } = home;

// Schema.org identity for the practice — gives AI engines a stable entity
// to attach the site's content to ("Tranquil Haven Coaching is …").
const site = Astro.site ?? new URL('https://srgolubev.github.io');
const siteUrl = new URL(withBase('/'), site).href;
const sameAs = (siteData.socials || [])
  .map((s: { url: string }) => s.url)
  .filter((u: string) => u && u !== '#' && /^https?:/i.test(u));
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': siteUrl + '#org',
  name: 'Tranquil Haven Coaching',
  url: siteUrl,
  description: seo.description,
  logo: new URL(withBase('/images/logo.webp'), site).href,
  image: new URL(withBase('/images/hero-coast.png'), site).href,
  slogan: 'Less noise. More you.',
  serviceType: 'Coaching',
  areaServed: 'Worldwide (online)',
  availableLanguage: ['English', 'Russian'],
  sameAs,
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': siteUrl + '#website',
  url: siteUrl,
  name: 'Tranquil Haven Coaching',
  inLanguage: 'en',
  publisher: { '@id': siteUrl + '#org' },
};

const PLACEHOLDER_CLASSES = [
  'media-placeholder--about',
  'media-placeholder--services',
  'media-placeholder--reviews',
];

const PERSON_ICON =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="9" r="3.7"/><path d="M5.2 19.4c1.3-3.5 4.1-5.2 6.8-5.2s5.5 1.7 6.8 5.2" stroke-linecap="round"/></svg>';
const IMAGE_ICON =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3.3" y="5" width="17.4" height="14" rx="2.6"/><circle cx="8.6" cy="10" r="1.9"/><path d="M4 16.6l4.6-4.1 3.6 3.1 3-2.6 5.1 4.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<Base title={seo.title} description={seo.description} jsonLd={[orgJsonLd, websiteJsonLd]}>
  <Header light />

  <!-- ====== HERO ====== -->
  <section class="hero" aria-labelledby="hero-h">
    <div
      class="hero-bg"
      role="img"
      aria-label={hero.imageAlt}
      style={`--hero-img: url("${withBase(hero.image)}")`}
    >
    </div>
    <div class="hero-content reveal">
      <h1 id="hero-h">
        <span class="welcome">{hero.welcome}</span>
        <span class="brand">{hero.brand}</span>
      </h1>
      <p class="subtitle">{hero.subtitle}</p>
      <a class="btn btn-primary" href={withBase(hero.ctaHref)}>
        <span>{hero.ctaLabel}</span>
      </a>
    </div>
  </section>

  <!-- ====== THREE CARDS ====== -->
  <section class="cards-section" id="about">
    <div class="waterline" aria-hidden="true"></div>
    <div class="container">
      <div class="cards">
        {
          cards.map((card, i) => (
            <article class:list={['card', 'reveal', card.variant === 'portrait' && 'is-portrait']}>
              <h2 class="h-eyebrow">{card.title}</h2>
              <div class="media">
                {card.image ? (
                  <img src={withBase(card.image)} alt={card.imageAlt} />
                ) : (
                  <div
                    class:list={[
                      'media-placeholder',
                      PLACEHOLDER_CLASSES[i] ?? 'media-placeholder--services',
                    ]}
                    role="img"
                    aria-label={`${card.title} — photo coming soon`}
                  >
                    <Fragment set:html={card.variant === 'portrait' ? PERSON_ICON : IMAGE_ICON} />
                    <span>{card.variant === 'portrait' ? 'Coach photo' : 'Photo coming soon'}</span>
                  </div>
                )}
              </div>
              <p class="body">{card.body}</p>
              <div class="divider"></div>
              <a
                class:list={['btn', card.buttonStyle === 'secondary' ? 'btn-secondary' : 'btn-primary']}
                href={withBase(card.buttonHref)}
              >
                <span>{card.buttonLabel}</span>
                <span class="btn-caret" aria-hidden="true">›</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ====== CTA BAND ====== -->
  <section class="cta-band" id="contact" aria-labelledby="cta-h">
    <div class="reveal">
      <h2 id="cta-h"><span>{cta.heading}</span></h2>
      <p>{cta.text}</p>
      <a class="btn btn-primary" href={withBase(cta.buttonHref)}>
        <span>{cta.buttonLabel}</span>
        <span class="btn-caret" aria-hidden="true">›</span>
      </a>
    </div>
  </section>

  <Footer />
</Base>
