# TinaCMS — required only for the hosted /admin in production.
# Create a free project at https://app.tina.io, connect this GitHub repo,
# then copy the values below. Local editing (npm run dev) works without them.
TINA_CLIENT_ID=
TINA_TOKEN=

# Git branch TinaCMS reads/writes content on (e.g. main).
GITHUB_BRANCH=main
